# /etc/ssh/sshd_config
Port {{ SSH_PORT }}
Protocol 2

# Logging
SyslogFacility AUTH
LogLevel INFO

# Authentication:
# root — вход ПО ПАРОЛЮ запрещён всегда, по ключу разрешён (нужно Ansible).
PermitRootLogin prohibit-password
PubkeyAuthentication yes
AuthorizedKeysFile	.ssh/authorized_keys
PasswordAuthentication no
PermitEmptyPasswords no

# SFTP:
Subsystem sftp internal-sftp

# Security
UsePAM yes
# ВАЖНО: AllowUsers должен включать root — Ansible ходит root-ом по ключу
# (PermitRootLogin prohibit-password выше). Без root в списке нода после рестарта
# sshd теряет любой SSH-доступ (только консоль провайдера).
AllowUsers root {{ NEW_USER_LOGIN }}
ClientAliveInterval 300
ClientAliveCountMax 2

# Performance
MaxAuthTries 3
MaxSessions 10