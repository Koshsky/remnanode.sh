services:
  remnanode:
    container_name: remnanode
    hostname: remnanode
    image: remnawave/node:2.7.0
    network_mode: host
    restart: always
    environment:
      NODE_PORT: "{{ REMNANODE_PORT }}"
      SECRET_KEY: "{{ REMNAWAVE_SECRET_KEY }}"
    cap_add:
      - NET_ADMIN
    volumes:
      - /var/log/remnanode:/var/log/remnanode
      - /opt/remnawave/xray/share/zapret.dat:/usr/local/share/xray/zapret.dat
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"